# Copy to .env for local development: cp .env.example .env
# Supabase > Project Settings > API keys. Both values are public (they ship in the
# front-end bundle); data is protected by row-level security and your login.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# NEVER put the secret / service_role key in this project: it bypasses all security.

# Optional, for `npm run export` (otherwise asked interactively).
# MNEMON_EMAIL=you@example.com
